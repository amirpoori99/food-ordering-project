<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns="http://javafx.com/javafx21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.dashbord.RestaurantFormController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">

    <content>
        <VBox spacing="25" alignment="TOP_CENTER"
              style="-fx-background-color: #f8fafc; -fx-padding: 40;">

            <!-- Header Section -->
            <VBox spacing="15" alignment="CENTER">
                <!-- App Icon -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #667eea;
                     -fx-background-radius: 25;
                     -fx-pref-width: 50;
                     -fx-pref-height: 50;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                    <Label text="🏪"
                           style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                </HBox>

                <!-- Title with Solid Background -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #667eea;
                     -fx-background-radius: 10;
                     -fx-padding: 15 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                    <Label text="Restaurant Details"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <!-- Form Section -->
            <VBox spacing="20"
                  style="-fx-background-color: white;
                 -fx-padding: 30;
                 -fx-background-radius: 15;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1;
                 -fx-border-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 3);">

                <GridPane hgap="20" vgap="18" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" prefWidth="350.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="45.0" prefHeight="45.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="45.0" prefHeight="45.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="45.0" prefHeight="45.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="45.0" prefHeight="45.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="45.0" prefHeight="45.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="20.0" prefHeight="20.0" vgrow="NEVER" />
                        <RowConstraints minHeight="100.0" prefHeight="120.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <!-- Restaurant Name -->
                    <Label text="🏪 Name:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField"
                               promptText="Restaurant name"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-border-color: #d1d5db;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;
                              -fx-pref-height: 40;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Restaurant Address -->
                    <Label text="📍 Address:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="addressField"
                               promptText="Restaurant address"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-border-color: #d1d5db;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;
                              -fx-pref-height: 40;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Restaurant Phone -->
                    <Label text="📱 Phone:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField"
                               promptText="Restaurant phone number"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-border-color: #d1d5db;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;
                              -fx-pref-height: 40;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Tax Fee -->
                    <Label text="💰 Tax Fee:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="taxField"
                               promptText="Restaurant tax fee"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-border-color: #d1d5db;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;
                              -fx-pref-height: 40;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Additional Fee -->
                    <Label text="➕ Additional Fee:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="additionalField"
                               promptText="Restaurant additional fee"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-border-color: #d1d5db;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;
                              -fx-pref-height: 40;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Spacer Row -->
                    <Label text="" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-min-height: 20;"/>

                    <!-- Restaurant Logo -->
                    <Label text="🖼️ Logo:"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"
                           GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                    <VBox GridPane.rowIndex="6" GridPane.columnIndex="1" spacing="10" alignment="CENTER_LEFT">
                        <!-- Image Container -->
                        <HBox alignment="CENTER"
                              style="-fx-background-color: #f8fafc;
                             -fx-background-radius: 12;
                             -fx-padding: 15;
                             -fx-border-color: #e2e8f0;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-pref-width: 130;
                             -fx-pref-height: 130;">
                            <ImageView fx:id="restaurantImageView"
                                       fitHeight="100" fitWidth="100"
                                       preserveRatio="true"
                                       style="-fx-background-radius: 8;">
                                <image>
                                    <Image url="@../../images/default_food_item.png"/>
                                </image>
                            </ImageView>
                        </HBox>

                        <!-- Upload Button -->
                        <MFXButton text="📷 Upload Logo"
                                   onAction="#handleLogoUpload"
                                   style="-fx-background-color: #3b82f6;
                                  -fx-text-fill: white;
                                  -fx-background-radius: 8;
                                  -fx-padding: 8 16;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: 500;
                                  -fx-cursor: hand;"/>
                    </VBox>
                </GridPane>

                <!-- Error Message (Only visible when there's an error) -->
                <Label fx:id="formErrorMessageLabel"
                       style="-fx-text-fill: #ef4444;
                      -fx-font-weight: bold;
                      -fx-font-size: 14px;
                      -fx-background-color: #fef2f2;
                      -fx-background-radius: 8;
                      -fx-padding: 12;
                      -fx-border-color: #fca5a5;
                      -fx-border-width: 1;
                      -fx-border-radius: 8;"
                       text=""
                       wrapText="true"
                       visible="false"
                       managed="false" />
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER"
                  style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <MFXButton text="💾 Save Restaurant"
                           onAction="#handleSaveRestaurant"
                           style="-fx-background-color: #10b981;
                          -fx-text-fill: white;
                          -fx-background-radius: 8;
                          -fx-padding: 12 24;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-cursor: hand;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>

                <MFXButton text="❌ Cancel"
                           onAction="#handleCancel"
                           style="-fx-background-color: #ef4444;
                          -fx-text-fill: white;
                          -fx-background-radius: 8;
                          -fx-padding: 12 24;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-cursor: hand;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>