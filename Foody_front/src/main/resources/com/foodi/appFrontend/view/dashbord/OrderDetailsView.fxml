<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodi.appFrontend.tabs.dashbord.OrderDetailsController"
      spacing="20" style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📋 Order Details"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20">
            <!-- Order Information -->
            <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Order Information"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <GridPane hgap="20" vgap="10">
                    <Label text="Order ID:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="orderIdLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                    
                    <Label text="Delivery Address:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="deliveryAddressLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                    
                    <Label text="Created At:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="createdAtLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    
                    <Label text="Updated At:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <Label fx:id="updatedAtLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                </GridPane>
            </VBox>

            <!-- Price Breakdown -->
            <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Price Breakdown"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <GridPane hgap="20" vgap="8">
                    <Label text="Raw Price:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="rawPriceLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Tax Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="taxFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    
                    <Label text="Additional Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="additionalFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    
                    <Label text="Courier Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="courierFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    
                    <Label text="Discount:" style="-fx-font-weight: bold; -fx-text-fill: #28a745;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="discountLabel" text="" style="-fx-text-fill: #28a745;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    
                    <Label text="Total Price:" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 16px;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="totalPriceLabel" text="" style="-fx-text-fill: #1f2937; -fx-font-size: 16px; -fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Order Items -->
            <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Order Items"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="200">
                    <TableView fx:id="orderItemsTable"
                               style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="itemIdColumn" text="Item ID" prefWidth="80"/>
                            <TableColumn fx:id="itemNameColumn" text="Name" prefWidth="150"/>
                            <TableColumn fx:id="itemDescriptionColumn" text="Description" prefWidth="200"/>
                            <TableColumn fx:id="itemPriceColumn" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="itemKeywordsColumn" text="Keywords" prefWidth="150" minWidth="100"/>
                        </columns>

                    </TableView>
                </ScrollPane>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Close Button -->
    <HBox alignment="CENTER_RIGHT">
        <MFXButton text="Close"
                   onAction="#handleClose"
                   style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>

</VBox> 