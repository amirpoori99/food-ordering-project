<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.dashbord.BuyerDashboard"
            style="-fx-background-color: #f8fafc;">

    <fx:define>
        <ToggleGroup fx:id="paymentMethodGroup" />
    </fx:define>

    <top>
        <!-- Header Section -->
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <!-- Top Bar with Title and Logout -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 30 15 30; -fx-background-color: white;">
                <!-- App Icon -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #667eea;
                             -fx-background-radius: 25;
                             -fx-pref-width: 50;
                             -fx-pref-height: 50;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                    <Label text="🍔"
                           style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                </HBox>

                <!-- Title with Solid Background -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #667eea;
                             -fx-background-radius: 8;
                             -fx-padding: 8 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                    <Label text="Fooody Buyer Dashboard"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Current Balance Display -->
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #f0f9ff;
                             -fx-background-radius: 20;
                             -fx-padding: 8 16;
                             -fx-border-color: #0284c7;
                             -fx-border-width: 1;
                             -fx-border-radius: 20;">
                    <Label text="💰 Balance:"
                           style="-fx-font-size: 13px; -fx-text-fill: #0284c7; -fx-font-weight: 600;"/>
                    <Label fx:id="currentWalletBalanceLabel"
                           text="/$0.00"
                           style="-fx-font-size: 13px; -fx-text-fill: #0284c7; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Error Message -->
                <Label fx:id="errorMessageLabel"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"
                       wrapText="true" />

                <!-- Logout Button -->
                <MFXButton text="Logout"
                           onAction="#logout"
                           style="-fx-background-color: #ef4444;
                                 -fx-text-fill: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 20;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: bold;
                                 -fx-cursor: hand;"/>
            </HBox>

            <!-- Browser-style Tab Navigation -->
            <HBox spacing="0" style="-fx-padding: 0 30 0 30; -fx-background-color: #f1f5f9;">
                <MFXButton fx:id="restaurantsTab"
                           text="🏪 Restaurants"
                           onAction="#switchToRestaurantsTab"
                           style="-fx-background-color: white;
                                 -fx-text-fill: #374151;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 600;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 1 1 0 1;
                                 -fx-background-radius: 8 8 0 0;
                                 -fx-border-radius: 8 8 0 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="foodItemsTab"
                           text="🍕 Food Items"
                           onAction="#switchToFoodItemsTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="orderHistoryTab"
                           text="📋 Order History"
                           onAction="#switchToOrderHistoryTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="profileTab"
                           text="👤 My Profile"
                           onAction="#switchToProfileTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="favoritesTab"
                           text="❤️ Favorites"
                           onAction="#switchToFavoritesTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="walletTab"
                           text="💳 Wallet"
                           onAction="#switchToWalletTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <!-- Spacer to fill remaining space -->
                <Region HBox.hgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane"
                 BorderPane.alignment="CENTER"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-tab-header-area-tabs-breadth: 0; -fx-padding: 0;">
            <tabs>
                <Tab text="Restaurants">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <Label text="Available Restaurants"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <!-- Controls Section -->
                            <VBox spacing="15"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                
                                <!-- Search Row 1 -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <TextField fx:id="searchRestaurantField"
                                               promptText="🔍 Search restaurants..."
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 250;"/>
                                    <TextField fx:id="keywordsField"
                                               promptText="🏷️ Keywords (comma-separated)"
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 200;"/>
                                    <TextField fx:id="minRatingField"
                                               promptText="⭐ Min Rating (0.0-5.0)"
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 150;"/>
                                </HBox>
                                
                                <!-- Search Row 2 -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <MFXButton text="🔍 Search"
                                               onAction="#searchRestaurants"
                                               style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="🔄 Refresh"
                                               onAction="#viewRestaurants"
                                               style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="❤️ Add to Favorites"
                                               onAction="#handleAddFavorite"
                                               style="-fx-background-color: #ec4899; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="📋 View Menu"
                                               onAction="#handleViewMenu"
                                               style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <!-- Table Section -->
                            <TableView fx:id="restaurantsTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="restaurantIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="restaurantNameColumn" text="Restaurant Name" prefWidth="200"/>
                                    <TableColumn fx:id="restaurantAddressColumn" text="Address" prefWidth="200"/>
                                    <TableColumn fx:id="restaurantPhoneColumn" text="Phone" prefWidth="130"/>
                                    <TableColumn fx:id="restaurantRatingColumn" text="Rating" prefWidth="80"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Food Items">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <Label text="Available Food Items"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <!-- Controls Section -->
                            <VBox spacing="15"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                
                                <!-- Search Row 1 -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <TextField fx:id="searchFoodItemField"
                                               promptText="🔍 Search food items..."
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 250;"/>
                                    <TextField fx:id="foodItemKeywordsField"
                                               promptText="🏷️ Keywords (comma-separated)"
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 200;"/>
                                    <TextField fx:id="maxPriceField"
                                               promptText="💰 Max Price"
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 150;"/>
                                </HBox>
                                
                                <!-- Search Row 2 -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <MFXButton text="🔍 Search"
                                               onAction="#searchFoodItems"
                                               style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="🔄 Refresh"
                                               onAction="#viewFoodItems"
                                               style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="🏪 View Restaurant"
                                               onAction="#handleViewRestaurant"
                                               style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                    <MFXButton text="👁️ View Details"
                                               onAction="#handleViewFoodItemDetails"
                                               style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <!-- Table Section -->
                            <TableView fx:id="foodItemsTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="foodItemIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="foodItemNameColumn" text="Food Item Name" prefWidth="180"/>
                                    <TableColumn fx:id="foodItemDescriptionColumn" text="Description" prefWidth="220"/>
                                    <TableColumn fx:id="foodItemPriceColumn" text="Price" prefWidth="100"/>
                                    <TableColumn fx:id="foodItemVendorIdColumn" text="Vendor ID" prefWidth="100"/>
                                    <TableColumn fx:id="foodItemSupplyColumn" text="Supply" prefWidth="80"/>
                                    <TableColumn fx:id="foodItemRatingColumn" text="Rating" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Order History">
                    <content>
                        <ScrollPane fitToWidth="true" 
                                   fitToHeight="true"
                                   style="-fx-background-color: transparent; -fx-background: transparent;"
                                   hbarPolicy="AS_NEEDED"
                                   vbarPolicy="AS_NEEDED">
                            <VBox spacing="25"
                                  alignment="TOP_LEFT"
                                  style="-fx-background-color: white; -fx-padding: 40;">

                                <Label text="My Order History"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                                <!-- Filters Section -->
                                <HBox spacing="15"
                                      alignment="CENTER_LEFT"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                    <Label text="Time Period:" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <ComboBox fx:id="buyerTimePeriodFilter"
                                              promptText="All Time"
                                              style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                                    <Label text="Status:" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                    <ComboBox fx:id="buyerOrderStatusFilter"
                                              promptText="All Statuses"
                                              style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                                    <MFXButton text="🔄 Refresh Orders"
                                               onAction="#viewOrderHistory"
                                               style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                </HBox>

                                <!-- Table Section -->
                                <TableView fx:id="orderHistoryTable"
                                           VBox.vgrow="ALWAYS"
                                           prefHeight="400"
                                           style="-fx-background-color: white;
                                                 -fx-border-color: #e2e8f0;
                                                 -fx-border-radius: 12;
                                                 -fx-background-radius: 12;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                    <columns>
                                        <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="80"/>
                                        <TableColumn fx:id="orderVendorColumn" text="Vendor ID" prefWidth="100"/>
                                        <TableColumn fx:id="orderStatusColumn" text="Status" prefWidth="120"/>
                                        <TableColumn fx:id="orderPriceColumn" text="Total Price" prefWidth="110"/>
                                        <TableColumn fx:id="orderDateColumn" text="Order Date" prefWidth="150"/>
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                </TableView>

                                <!-- Order Actions Buttons -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <MFXButton text="📋 Detail of Order"
                                               onAction="#handleViewOrderDetails"
                                               style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                    <MFXButton text="⭐ Rate Order"
                                               onAction="#handleRateSelectedOrder"
                                               style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                </HBox>

                                <!-- Payment Section -->
                                <VBox spacing="15"
                                      style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                    <Label text="Payment Options"
                                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                                    <HBox spacing="20" alignment="CENTER_LEFT">
                                        <RadioButton text="💰 Pay with Wallet"
                                                     toggleGroup="$paymentMethodGroup"
                                                     userData="wallet"
                                                     fx:id="walletRadioButton"
                                                     style="-fx-font-size: 14px; -fx-text-fill: #374151; -fx-font-weight: 500;" />
                                        <RadioButton text="💳 Pay Online"
                                                     toggleGroup="$paymentMethodGroup"
                                                     userData="online"
                                                     fx:id="onlineRadioButton"
                                                     style="-fx-font-size: 14px; -fx-text-fill: #374151; -fx-font-weight: 500;" />
                                        <MFXButton text="💸 Make Payment"
                                                   onAction="#handleMakePayment"
                                                   style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab text="My Profile">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">
                            <Label text="My Profile"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                            <AnchorPane fx:id="myProfileContainer"
                                        style="-fx-background-color: #f8fafc;
                                              -fx-background-radius: 12;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 1;
                                              -fx-border-radius: 12;
                                              -fx-min-height: 400;" />
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Manage Favorites">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <Label text="My Favorite Restaurants"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <!-- Controls Section -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                <MFXButton text="🗑️ Remove from Favorites"
                                           onAction="#handleRemoveFavorite"
                                           style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;" />
                                <MFXButton text="📋 View Menu"
                                           onAction="#handleViewFavoriteMenu"
                                           style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;" />
                            </HBox>

                            <!-- Table Section -->
                            <TableView fx:id="favoriteRestaurantTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="favRestaurantIdColumn" text="ID" prefWidth="60" />
                                    <TableColumn fx:id="favRestaurantNameColumn" text="Restaurant Name" prefWidth="200" />
                                    <TableColumn fx:id="favRestaurantAddressColumn" text="Address" prefWidth="250" />
                                    <TableColumn fx:id="favRestaurantPhoneColumn" text="Phone" prefWidth="130" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Wallet and Payments">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <!-- Title with Solid Background -->
                            <HBox alignment="CENTER_LEFT"
                                  style="-fx-background-color: #667eea;
                                         -fx-background-radius: 10;
                                         -fx-padding: 15 20;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                                <Label text="Wallet &amp; Payment Management"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            </HBox>

                            <!-- Wallet Balance Section -->
                            <VBox spacing="15"
                                  style="-fx-background-color: #10b981;
                                         -fx-background-radius: 12;
                                         -fx-padding: 25;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                                <Label text="Current Wallet Balance"
                                       style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: 600;"/>
                                <Label fx:id="currentWalletBalanceLabel2"
                                       text="/$0.00"
                                       style="-fx-font-size: 32px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>

                            <!-- Top-up Section -->
                            <VBox spacing="15"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                <Label text="Top-up Your Wallet"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <TextField fx:id="topUpAmountField"
                                               promptText="💵 Enter amount..."
                                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 200;"
                                               HBox.hgrow="ALWAYS" />
                                    <MFXButton text="💰 Top-up Wallet"
                                               onAction="#handleTopUp"
                                               style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <!-- Transaction History -->
                            <Label text="Transaction History"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <TableView fx:id="transactionsTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="350"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="transactionIdColumn" text="Transaction ID" prefWidth="120"/>
                                    <TableColumn fx:id="transactionOrderIdColumn" text="Order ID" prefWidth="100"/>
                                    <TableColumn fx:id="transactionUserIdColumn" text="User ID" prefWidth="100"/>
                                    <TableColumn fx:id="transactionMethodColumn" text="Payment Method" prefWidth="140"/>
                                    <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>