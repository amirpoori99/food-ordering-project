<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodi.appFrontend.tabs.dashbord.RatingDialogController"
      spacing="0"
      style="-fx-background-color: #f8fafc; -fx-min-width: 600; -fx-min-height: 700;"
      VBox.vgrow="ALWAYS">

    <!-- Header with Solid Background -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #667eea;
                 -fx-background-radius: 10;
                 -fx-padding: 15 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
        <Label text="⭐ Rate Your Order"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" 
               fitToHeight="true"
               style="-fx-background-color: transparent; -fx-background: transparent;"
               hbarPolicy="AS_NEEDED"
               vbarPolicy="AS_NEEDED"
               VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 30;">
            

                        <!-- Price Breakdown Section -->
                        <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                            <Label text="Price Breakdown"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                            
                            <GridPane hgap="20" vgap="8">
                                <Label text="Raw Price:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="rawPriceLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                
                                <Label text="Tax Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="taxFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                
                                <Label text="Additional Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="additionalFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                
                                <Label text="Courier Fee:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label fx:id="courierFeeLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                
                                <Label text="Total Price:" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 16px;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <Label fx:id="totalPriceLabel" text="" style="-fx-text-fill: #1f2937; -fx-font-size: 16px; -fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>

                        <!-- Order Items Section -->
                        <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                            <Label text="Order Items"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                            
                            <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="200">
                                <TableView fx:id="orderItemsTable"
                                           style="-fx-background-color: white;">
                                    <columns>
                                        <TableColumn fx:id="itemNameColumn" text="Name" prefWidth="200"/>
                                        <TableColumn fx:id="itemPriceColumn" text="Price" prefWidth="100"/>
                                        <TableColumn fx:id="itemDescriptionColumn" text="Description" prefWidth="250"/>
                                    </columns>
                                </TableView>
                            </ScrollPane>
                        </VBox>

            <!-- Rating Section -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <Label text="Your Rating"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <!-- Rating Slider -->
                <VBox spacing="8">
                    <Slider fx:id="ratingSlider"
                            min="1" max="5" value="3"
                            showTickLabels="true"
                            showTickMarks="true"
                            majorTickUnit="1"
                            minorTickCount="0"
                            snapToTicks="true"
                            style="-fx-show-tick-labels: true; -fx-show-tick-marks: true;"/>
                    
                    <!-- Rating Display -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Rating:"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <Label fx:id="ratingValueLabel"
                               text="3"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        <Label text="stars"
                               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Comment Section -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <Label text="Share Your Experience (Optional)"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <TextArea fx:id="commentTextArea"
                          promptText="Tell us about your experience with this order..."
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"
                          prefRowCount="4"
                          wrapText="true"/>
            </VBox>

            <!-- Image Upload Section -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <Label text="Add Photos (Optional)"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <!-- Image Upload Button -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="📷 Add Photo"
                            onAction="#handleAddPhoto"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Label text="Share photos of your food or experience"
                           style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                </HBox>
                
                <!-- Image Preview Area -->
                <VBox fx:id="imagePreviewContainer"
                      spacing="10"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1; -fx-min-height: 100;">
                    <Label text="No photos added yet"
                           fx:id="noImagesLabel"
                           style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-alignment: center;"/>
                </VBox>
            </VBox>

            <!-- Buttons Section -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <MFXButton text="❌ Cancel"
                           onAction="#handleCancel"
                           style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
                <MFXButton text="⭐ Submit Rating"
                           onAction="#handleSubmitRating"
                           style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox> 