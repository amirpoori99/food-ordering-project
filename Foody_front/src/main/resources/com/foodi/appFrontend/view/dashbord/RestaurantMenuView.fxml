<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodi.appFrontend.tabs.dashbord.RestaurantMenuController"
      spacing="0" alignment="TOP_CENTER"
      style="-fx-background-color: #f8fafc;">

    <!-- Header Section -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <!-- Top Bar with Restaurant Info -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 30 15 30; -fx-background-color: white;">
            <!-- Restaurant Logo with Modern Styling -->
            <HBox alignment="CENTER"
                  style="-fx-background-color: #667eea;
                         -fx-background-radius: 15;
                         -fx-pref-width: 80;
                         -fx-pref-height: 80;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                <ImageView fx:id="restaurantLogoImageView"
                           fitWidth="70" fitHeight="70"
                           preserveRatio="true"
                           style="-fx-background-radius: 12;"/>
            </HBox>

            <!-- Restaurant Details -->
            <VBox spacing="5">
                <Label fx:id="restaurantNameLabel"
                       text="Restaurant Name"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label fx:id="restaurantAddressLabel"
                       text="Address"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-font-weight: 500;"/>
                <Label fx:id="restaurantPhoneLabel"
                       text="Phone"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-font-weight: 500;"/>
            </VBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Menu Title with Solid Background -->
            <HBox alignment="CENTER"
                  style="-fx-background-color: #667eea;
                         -fx-background-radius: 8;
                         -fx-padding: 8 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                <Label text="Restaurant Menu"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
        </HBox>

        <!-- Menu Categories Section (Browser-tab style) -->
        <HBox fx:id="menuCategoriesContainer" spacing="0" style="-fx-padding: 0 30 0 30; -fx-background-color: #f1f5f9;">
            <!-- Menu titles will be added here dynamically -->
            
            <!-- Spacer to fill remaining space -->
            <Region HBox.hgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;"/>
        </HBox>
    </VBox>

    <!-- Main Content Area -->
    <VBox spacing="25" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 40;" VBox.vgrow="ALWAYS">

        <!-- Menu Items Title -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #667eea;
                     -fx-background-radius: 10;
                     -fx-padding: 15 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
            <Label text="Menu Items"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>

        <!-- Menu TabPane with Modern Styling -->
        <TabPane fx:id="menuTabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 VBox.vgrow="ALWAYS"
                 style="-fx-background-color: white;
                       -fx-border-color: #e2e8f0;
                       -fx-border-radius: 12;
                       -fx-background-radius: 12;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);
                       -fx-tab-min-width: 120;
                       -fx-tab-max-width: 200;">
        </TabPane>

        <!-- Status Message with Modern Styling -->
        <HBox alignment="CENTER"
              style="-fx-background-color: #fef3c7;
                     -fx-background-radius: 8;
                     -fx-padding: 10 15;
                     -fx-border-color: #f59e0b;
                     -fx-border-width: 1;
                     -fx-border-radius: 8;">
            <Label fx:id="menuErrorMessageLabel"
                   textFill="#d97706"
                   wrapText="true"
                   text="Ready to browse menu..."
                   style="-fx-font-size: 14px; -fx-font-weight: 500;"/>
        </HBox>

        <!-- Action Buttons at Bottom -->
        <HBox spacing="15" alignment="CENTER"
              style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
            <MFXButton text="Add to Cart"
                       onAction="#handleAddToCart"
                       style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <MFXButton text="👁️ View Details"
                       onAction="#handleViewItemDetails"
                       style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <MFXButton text="View Cart and Order"
                       onAction="#handleViewCartAndOrder"
                       style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <MFXButton text="Close"
                       onAction="#handleClose"
                       style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

    </VBox>

</VBox>