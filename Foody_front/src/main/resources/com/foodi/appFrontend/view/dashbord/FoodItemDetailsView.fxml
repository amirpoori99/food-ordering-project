<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodi.appFrontend.tabs.dashbord.FoodItemDetailsController"
      spacing="20" style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🍽️ Food Item Details"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20">
            <!-- Food Item Image and Basic Info -->
            <HBox spacing="20" alignment="TOP_LEFT">
                <!-- Food Item Image -->
                <VBox spacing="10" alignment="CENTER">
                    <ImageView fx:id="foodItemImageView"
                               fitWidth="200" fitHeight="200"
                               preserveRatio="true"
                               style="-fx-background-color: #f3f4f6; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 2;">
                        <image>
                            <Image url="@../../images/default_food_item.png"/>
                        </image>
                    </ImageView>
                </VBox>

                <!-- Basic Information -->
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <VBox spacing="5">
                        <Label text="Name" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                        <Label fx:id="nameLabel" text="" style="-fx-text-fill: #1f2937; -fx-font-size: 16px; -fx-font-weight: 500;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                        <Label fx:id="descriptionLabel" text="" wrapText="true" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                    </VBox>

                    <HBox spacing="30">
                        <VBox spacing="5">
                            <Label text="Price" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                            <Label fx:id="priceLabel" text="" style="-fx-text-fill: #10b981; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Available Supply" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                            <Label fx:id="supplyLabel" text="" style="-fx-text-fill: #3b82f6; -fx-font-size: 16px; -fx-font-weight: 500;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Rating" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                            <Label fx:id="ratingLabel" text="" style="-fx-text-fill: #f59e0b; -fx-font-size: 16px; -fx-font-weight: 500;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Item ID" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                            <Label fx:id="idLabel" text="" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Keywords Section -->
            <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Keywords" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <VBox fx:id="keywordsContainer" spacing="8">
                    <!-- Keywords will be added here dynamically -->
                </VBox>
            </VBox>

            <!-- Restaurant Information -->
            <VBox spacing="10" style="-fx-background-color: #f0f9ff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #0ea5e9; -fx-border-width: 1; -fx-border-radius: 8;">
                <Label text="Restaurant Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <GridPane hgap="20" vgap="8">
                    <Label text="Restaurant Name:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="restaurantNameLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Restaurant Address:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="restaurantAddressLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    
                    <Label text="Restaurant Phone:" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="restaurantPhoneLabel" text="" style="-fx-text-fill: #6b7280;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Customer Reviews Section -->
            <VBox spacing="10" style="-fx-background-color: #fef3c7; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #f59e0b; -fx-border-width: 1; -fx-border-radius: 8;">
                <Label text="⭐ Customer Reviews" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <ScrollPane fitToWidth="true" prefHeight="200" minHeight="150" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="reviewsContainer" spacing="10" minHeight="120">
                        <!-- Reviews will be added here dynamically -->
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <MFXButton text="Add to Cart"
                   onAction="#handleAddToCart"
                   style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <MFXButton text="Close"
                   onAction="#handleClose"
                   style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox> 