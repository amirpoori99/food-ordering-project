<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER"
      prefHeight="650.0"
      prefWidth="550.0"
      spacing="25"
      style="-fx-padding: 40;
             -fx-background-color: white;
             -fx-border-color: #e2e8f0;
             -fx-border-radius: 12;
             -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodi.appFrontend.tabs.dashbord.CouponFormController">

    <!-- Header Section -->
    <VBox alignment="CENTER" spacing="8">
        <Label style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1f2937;"
               text="Coupon Management" />
        <Label style="-fx-font-size: 14px;
                      -fx-text-fill: #6b7280;"
               text="Create or edit coupon details" />
    </VBox>

    <!-- Form Section -->
    <VBox spacing="20"
          style="-fx-background-color: #f8fafc;
                 -fx-padding: 30;
                 -fx-background-radius: 12;">

        <GridPane hgap="15" vgap="20" prefWidth="460.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="280.0" prefWidth="320.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <!-- Coupon Code -->
            <Label text="Coupon Code:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0" />
            <MFXTextField fx:id="couponCodeField"
                          promptText="e.g., BLACKFRIDAY"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;
                                 -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0" />

            <!-- Type -->
            <Label text="Type:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1" />
            <ComboBox fx:id="couponTypeComboBox"
                      maxWidth="1.7976931348623157E308"
                      promptText="Select type..."
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-padding: 8 12;
                             -fx-font-size: 14px;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;
                             -fx-border-width: 1;"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1" />

            <!-- Value -->
            <Label text="Value:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2" />
            <MFXTextField fx:id="couponValueField"
                          promptText="e.g., 10.0 or 0.15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;
                                 -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2" />

            <!-- Min. Price -->
            <Label text="Min. Price:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3" />
            <MFXTextField fx:id="couponMinPriceField"
                          promptText="e.g., 500"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;
                                 -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3" />

            <!-- User Count -->
            <Label text="User Count:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="4" />
            <MFXTextField fx:id="couponUserCountField"
                          promptText="e.g., 100"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;
                                 -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4" />

            <!-- Start Date -->
            <Label text="Start Date:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="5" />
            <DatePicker fx:id="couponStartDatePicker"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: white;
                               -fx-background-radius: 8;
                               -fx-padding: 8 12;
                               -fx-font-size: 14px;
                               -fx-border-color: #d1d5db;
                               -fx-border-radius: 8;
                               -fx-border-width: 1;"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="5" />

            <!-- End Date -->
            <Label text="End Date:"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #374151;
                          -fx-font-weight: 600;"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="6" />
            <DatePicker fx:id="couponEndDatePicker"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: white;
                               -fx-background-radius: 8;
                               -fx-padding: 8 12;
                               -fx-font-size: 14px;
                               -fx-border-color: #d1d5db;
                               -fx-border-radius: 8;
                               -fx-border-width: 1;"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="6" />
        </GridPane>
    </VBox>

    <!-- Error Message -->
    <Label fx:id="formErrorMessageLabel"
           style="-fx-text-fill: #ef4444;
                  -fx-font-size: 14px;
                  -fx-font-weight: 500;"
           wrapText="true" />

    <!-- Action Buttons -->
    <HBox alignment="CENTER"
          spacing="15"
          style="-fx-padding: 20 0 0 0;">
        <MFXButton onAction="#handleSaveCoupon"
                   text="💾 Save Coupon"
                   style="-fx-background-color: #10b981;
                          -fx-text-fill: white;
                          -fx-background-radius: 8;
                          -fx-padding: 12 24;
                          -fx-font-size: 14px;
                          -fx-font-weight: 600;
                          -fx-cursor: hand;
                          -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 4, 0, 0, 2);" />
        <MFXButton onAction="#handleCancel"
                   text="❌ Cancel"
                   style="-fx-background-color: #6b7280;
                          -fx-text-fill: white;
                          -fx-background-radius: 8;
                          -fx-padding: 12 24;
                          -fx-font-size: 14px;
                          -fx-font-weight: 600;
                          -fx-cursor: hand;" />
    </HBox>
</VBox>