<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.layout.AnchorPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.dashbord.CourierDashboard"
            style="-fx-background-color: #f8fafc;">

    <top>
        <!-- Header Section -->
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <!-- Top Bar with Title and Logout -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 30 15 30; -fx-background-color: white;">
                <!-- App Icon -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #f59e0b;
                             -fx-background-radius: 25;
                             -fx-pref-width: 50;
                             -fx-pref-height: 50;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                    <Label text="🚚"
                           style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                </HBox>

                <!-- Title with Solid Background -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #f59e0b;
                             -fx-background-radius: 8;
                             -fx-padding: 8 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                    <Label text="Fooody Courier Dashboard"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Status Display -->
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #ecfdf5;
                             -fx-background-radius: 20;
                             -fx-padding: 8 16;
                             -fx-border-color: #10b981;
                             -fx-border-width: 1;
                             -fx-border-radius: 20;">
                    <Label text="🚴 Status:"
                           style="-fx-font-size: 13px; -fx-text-fill: #10b981; -fx-font-weight: 600;"/>
                    <Label text="Available"
                           style="-fx-font-size: 13px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Error Message -->
                <Label fx:id="errorMessageLabel"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"
                       wrapText="true" />

                <!-- Logout Button -->
                <MFXButton text="Logout"
                           onAction="#logout"
                           style="-fx-background-color: #ef4444;
                                 -fx-text-fill: white;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 20;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: bold;
                                 -fx-cursor: hand;"/>
            </HBox>

            <!-- Browser-style Tab Navigation -->
            <HBox spacing="0" style="-fx-padding: 0 30 0 30; -fx-background-color: #f1f5f9;">
                <MFXButton fx:id="availableDeliveriesTab"
                           text="📦 Available Deliveries"
                           onAction="#switchToAvailableDeliveriesTab"
                           style="-fx-background-color: white;
                                 -fx-text-fill: #374151;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 600;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 1 1 0 1;
                                 -fx-background-radius: 8 8 0 0;
                                 -fx-border-radius: 8 8 0 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="deliveryHistoryTab"
                           text="📋 Delivery History"
                           onAction="#switchToDeliveryHistoryTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="transactionsTab"
                           text="💳 Transactions"
                           onAction="#switchToTransactionsTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <MFXButton fx:id="profileTab"
                           text="👤 My Profile"
                           onAction="#switchToProfileTab"
                           style="-fx-background-color: #f1f5f9;
                                 -fx-text-fill: #6b7280;
                                 -fx-padding: 12 24;
                                 -fx-font-size: 14px;
                                 -fx-font-weight: 500;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-width: 0 0 1 0;
                                 -fx-cursor: hand;"/>

                <!-- Spacer to fill remaining space -->
                <Region HBox.hgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane"
                 BorderPane.alignment="CENTER"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-tab-header-area-tabs-breadth: 0; -fx-padding: 0;">
            <tabs>
                <Tab text="Available Deliveries">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <Label text="Available Deliveries"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <!-- Controls Section -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                <MFXButton text="🔄 Refresh Available"
                                           onAction="#viewAvailableDeliveries"
                                           style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                <MFXButton text="✅ Accept Delivery"
                                           onAction="#acceptDelivery"
                                           style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Table Section -->
                            <TableView fx:id="availableDeliveriesTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="availableOrderIdColumn" text="Order ID" prefWidth="80"/>
                                    <TableColumn fx:id="availableVendorIdColumn" text="Vendor ID" prefWidth="100"/>
                                    <TableColumn fx:id="availableDeliveryAddressColumn" text="Delivery Address" prefWidth="300"/>
                                    <TableColumn fx:id="availableStatusColumn" text="Status" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Delivery History">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <Label text="Delivery History"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                            <!-- Controls Section -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                <Label text="Time Period:" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="courierTimePeriodFilter"
                                          promptText="All Time"
                                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                                <Label text="Status:" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="courierOrderStatusFilter"
                                          promptText="All Statuses"
                                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                                <MFXButton text="🔄 Refresh History"
                                           onAction="#viewDeliveryHistory"
                                           style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                <MFXButton text="📋 View Order Details"
                                           onAction="#handleViewOrderDetailsHistory"
                                           style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                <MFXButton text="📨 Mark Received"
                                           onAction="#markDeliveryReceived"
                                           style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                                <MFXButton text="✅ Mark Delivered"
                                           onAction="#markDeliveryDelivered"
                                           style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Table Section -->
                            <TableView fx:id="deliveryHistoryTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="historyOrderIdColumn" text="Order ID" prefWidth="80"/>
                                    <TableColumn fx:id="historyVendorIdColumn" text="Vendor ID" prefWidth="100"/>
                                    <TableColumn fx:id="historyDeliveryAddressColumn" text="Delivery Address" prefWidth="250"/>
                                    <TableColumn fx:id="historyStatusColumn" text="Status" prefWidth="120"/>
                                    <TableColumn fx:id="historyUpdatedAtColumn" text="Updated At" prefWidth="150"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Courier Transactions">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">

                            <!-- Title with Solid Background -->
                            <HBox alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f59e0b;
                                         -fx-background-radius: 10;
                                         -fx-padding: 15 20;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                                <Label text="Courier Transaction History"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            </HBox>

                            <!-- Controls Section -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                                <MFXButton text="🔄 Refresh Transactions"
                                           onAction="#viewCourierTransactions"
                                           style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Table Section -->
                            <TableView fx:id="courierTransactionsTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="450"
                                       style="-fx-background-color: white;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-radius: 12;
                                             -fx-background-radius: 12;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="transactionIdColumn" text="Transaction ID" prefWidth="120"/>
                                    <TableColumn fx:id="transactionOrderIdColumn" text="Order ID" prefWidth="100"/>
                                    <TableColumn fx:id="transactionUserIdColumn" text="User ID" prefWidth="100"/>
                                    <TableColumn fx:id="transactionMethodColumn" text="Payment Method" prefWidth="140"/>
                                    <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="My Profile">
                    <content>
                        <VBox spacing="25"
                              alignment="TOP_LEFT"
                              style="-fx-background-color: white; -fx-padding: 40;">
                            <Label text="My Profile"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                            <AnchorPane fx:id="myProfileContainer"
                                        style="-fx-background-color: #f8fafc;
                                              -fx-background-radius: 12;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 1;
                                              -fx-border-radius: 12;
                                              -fx-min-height: 400;" />
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>