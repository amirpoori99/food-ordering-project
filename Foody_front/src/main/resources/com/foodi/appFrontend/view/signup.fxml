<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXPasswordField?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.scene.control.Hyperlink?>
<?import java.net.URL?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane prefHeight="700.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.signup.Signup">

    <stylesheets>
        <URL value="@../css/application.css" />
    </stylesheets>

    <center>
        <!-- Scrollable Container for the form -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox alignment="CENTER" style="-fx-padding: 30;">
                <!-- Main Signup Container -->
                <VBox alignment="CENTER"
                      spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 10);
                             -fx-max-width: 500;
                             -fx-min-height: 680;
                             -fx-padding: 0;">

                    <!-- Header Section -->
                    <VBox alignment="CENTER"
                          spacing="15"
                          style="-fx-padding: 40 40 30 40; -fx-background-color: transparent;">

                        <!-- App Icon/Logo Area -->
                        <HBox alignment="CENTER"
                              style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);
                                 -fx-background-radius: 50;
                                 -fx-pref-width: 80;
                                 -fx-pref-height: 80;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                            <Label text="🍔"
                                   style="-fx-font-size: 32px; -fx-text-fill: black;"/>
                </HBox>

                        <!-- Welcome Text -->
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="Join Fooody!"
                                   style="-fx-font-size: 26px;
                                     -fx-font-weight: bold;
                                     -fx-text-fill: #1f2937;"/>
                            <Label text="Create your account to get started"
                                   style="-fx-font-size: 14px;
                                     -fx-text-fill: #6b7280;
                                     -fx-font-weight: 500;"/>
                        </VBox>
                    </VBox>

                    <!-- Form Section -->
                    <VBox alignment="CENTER"
                          spacing="20"
                          style="-fx-padding: 0 40 40 40;">

                        <!-- Full Name Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Full Name"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="nameField"
                                          floatingText="Enter your full name"
                                          promptText="Full Name"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Phone Number Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Phone Number"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="phoneField"
                                          floatingText="Enter your phone number"
                                          promptText="Phone Number"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Email Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Email"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="emailField"
                                          floatingText="Enter your email"
                                          promptText="Email"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Password Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Password"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXPasswordField fx:id="passwordField"
                                              floatingText="Create a password"
                                              promptText="Password"
                                              prefHeight="45.0"
                                              prefWidth="420.0"
                                              style="-fx-background-color: #f8fafc;
                                               -fx-background-radius: 10;
                                               -fx-border-color: #e2e8f0;
                                               -fx-border-width: 1;
                                               -fx-border-radius: 10;
                                               -fx-padding: 0 14;
                                               -fx-font-size: 14px;
                                               -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Address Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Address"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="addressField"
                                          floatingText="Enter your address"
                                          promptText="Address"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Bank Name Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Bank Name (for Seller/Courier)"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="bankNameField"
                                          floatingText="Enter bank name"
                                          promptText="Bank Name (for Seller/Courier)"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Account Number Field -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Account Number (for Seller/Courier)"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <MFXTextField fx:id="accountField"
                                          floatingText="Enter account number"
                                          promptText="Account Number (for Seller/Courier)"
                                          prefHeight="45.0"
                                          prefWidth="420.0"
                                          style="-fx-background-color: #f8fafc;
                                           -fx-background-radius: 10;
                                           -fx-border-color: #e2e8f0;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-padding: 0 14;
                                           -fx-font-size: 14px;
                                           -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Role Selection -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Select Role"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="roleComboBox"
                                      promptText="Select Role"
                                      prefHeight="45.0"
                                      prefWidth="420.0"
                                      style="-fx-background-color: #f8fafc;
                                       -fx-background-radius: 10;
                                       -fx-border-color: #e2e8f0;
                                       -fx-border-width: 1;
                                       -fx-border-radius: 10;
                                       -fx-padding: 0 14;
                                       -fx-font-size: 14px;" />
                        </VBox>

                        <!-- Profile Picture Section -->
                        <VBox spacing="6" style="-fx-max-width: 420;">
                            <Label text="Profile Picture"
                                   style="-fx-font-size: 13px;
                                     -fx-font-weight: 600;
                                     -fx-text-fill: #374151;"/>
                            <HBox alignment="CENTER_LEFT" spacing="15"
                                  style="-fx-background-color: #f8fafc;
                                    -fx-background-radius: 10;
                                    -fx-border-color: #e2e8f0;
                                    -fx-border-width: 1;
                                    -fx-border-radius: 10;
                                    -fx-padding: 12 16;
                                    -fx-pref-height: 60;">
                                <MFXButton text="📁 Upload Image"
                                           onAction="#handleImageUpload"
                                           style="-fx-background-color: #3b82f6;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 8;
                                           -fx-padding: 8 16;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: 600;
                                           -fx-cursor: hand;" />
                                <ImageView fx:id="profileImageView"
                                           fitHeight="40.0"
                                           fitWidth="40.0"
                                           pickOnBounds="true"
                                           preserveRatio="true"
                                           style="-fx-background-color: #e5e7eb;
                                           -fx-background-radius: 20;" />
                            </HBox>
                        </VBox>

                        <!-- Error Message -->
                        <Label fx:id="errorMessageLabel"
                               textFill="#ef4444"
                               wrapText="true"
                               style="-fx-font-size: 13px;
                                  -fx-font-weight: 500;
                                  -fx-max-width: 420;
                                  -fx-text-alignment: center;"/>

                        <!-- Sign Up Button -->
                        <MFXButton fx:id="signupButton"
                                   onAction="#handleSignup"
                                   text="Create Account"
                                   prefWidth="420.0"
                                   prefHeight="45.0"
                                   style="-fx-background-color: #3b82f6;
                                     -fx-text-fill: white;
                                     -fx-background-radius: 10;
                                     -fx-font-size: 15px;
                                     -fx-font-weight: bold;
                                     -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 8, 0, 0, 4);" />

                        <!-- Login Link -->
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="Already have an account?"
                                   style="-fx-font-size: 14px;
                                     -fx-text-fill: #6b7280;
                                     -fx-font-weight: 500;"/>
                            <Hyperlink onAction="#login"
                                       text="Sign In"
                                       style="-fx-font-size: 14px;
                                        -fx-text-fill: #3b82f6;
                                        -fx-font-weight: 600;
                                        -fx-underline: false;"/>
                </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 15;">
            <Label text="© 2025 Fooody. All rights reserved."
                   style="-fx-font-size: 12px;
                         -fx-text-fill: rgba(255,255,255,0.8);
                         -fx-font-weight: 500;"/>
        </VBox>
    </bottom>
</BorderPane>