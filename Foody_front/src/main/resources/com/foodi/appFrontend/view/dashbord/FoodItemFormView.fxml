<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea ?>
<?import javafx.scene.control.TextField ?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox ?>
<?import javafx.scene.layout.HBox ?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets ?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.dashbord.FoodItemFormController"
            fitToWidth="true"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
    <content>
        <VBox spacing="25" alignment="TOP_CENTER"
              style="-fx-background-color: #f8fafc; -fx-padding: 40;"
        >
            <!-- Header Section -->
            <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-background-radius: 12;">
                <!-- Top Bar with App Icon and Title -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 30 15 30; -fx-background-color: white; -fx-background-radius: 12 12 0 0;">
                    <!-- App Icon -->
                    <HBox alignment="CENTER"
                          style="-fx-background-color: #667eea;
                         -fx-background-radius: 25;
                         -fx-pref-width: 50;
                         -fx-pref-height: 50;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 3);">
                        <Label text="🍕"
                               style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                    </HBox>

                    <!-- Title with Solid Background -->
                    <HBox alignment="CENTER"
                          style="-fx-background-color: #667eea;
                         -fx-background-radius: 8;
                         -fx-padding: 8 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                        <Label text="Food Item Details"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </HBox>

                    <!-- Spacer -->
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Main Form Container -->
            <VBox spacing="20"
                  style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 30;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">

                <!-- Form Fields Section -->
                <GridPane hgap="20" vgap="20" alignment="CENTER"
                          style="-fx-background-color: #f8fafc;
                         -fx-background-radius: 12;
                         -fx-padding: 25;">
                    <padding>
                        <Insets top="10" left="10" right="10" bottom="10"/>
                    </padding>

                    <!-- Name Field -->
                    <Label text="🍽️ Name:"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="nameField"
                               promptText="Enter food item name..."
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 16;
                              -fx-pref-width: 300;
                              -fx-border-color: #e2e8f0;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;"/>

                    <!-- Description Field -->
                    <Label text="📝 Description:"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextArea fx:id="descriptionField"
                              promptText="Write a detailed description..."
                              GridPane.rowIndex="1" GridPane.columnIndex="1"
                              prefRowCount="3"
                              style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-padding: 12 16;
                             -fx-pref-width: 300;
                             -fx-border-color: #e2e8f0;
                             -fx-border-width: 1;
                             -fx-border-radius: 8;"/>

                    <!-- Price Field -->
                    <Label text="💰 Price:"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="priceField"
                               promptText="Price (e.g., 15.99)"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 16;
                              -fx-pref-width: 300;
                              -fx-border-color: #e2e8f0;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;"/>

                    <!-- Supply Field -->
                    <Label text="📦 Supply:"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="supplyField"
                               promptText="Available quantity"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 16;
                              -fx-pref-width: 300;
                              -fx-border-color: #e2e8f0;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;"/>

                    <!-- Keywords Field -->
                    <Label text="🏷️ Keywords:"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <TextField fx:id="keywordsField"
                               promptText="e.g., burger, fast food, beef"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"
                               style="-fx-background-color: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 16;
                              -fx-pref-width: 300;
                              -fx-border-color: #e2e8f0;
                              -fx-border-width: 1;
                              -fx-border-radius: 8;"/>

                    <!-- Image Section -->
                    <Label text="📸 Image:"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                    <VBox GridPane.rowIndex="5" GridPane.columnIndex="1"
                          spacing="15" alignment="CENTER_LEFT"
                          style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-padding: 20;
                         -fx-border-color: #e2e8f0;
                         -fx-border-width: 1;
                         -fx-border-radius: 8;">
                        <!-- Image Preview Container -->
                        <HBox alignment="CENTER"
                              style="-fx-background-color: #f1f5f9;
                             -fx-background-radius: 8;
                             -fx-padding: 15;
                             -fx-border-color: #cbd5e1;
                             -fx-border-width: 2;
                             -fx-border-style: dashed;
                             -fx-border-radius: 8;">
                            <ImageView fx:id="foodItemImageView"
                                       fitWidth="120" fitHeight="120"
                                       preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                                <image>
                                    <Image url="@../../images/default_food_item.png"/>
                                </image>
                            </ImageView>
                        </HBox>

                        <!-- Upload Button -->
                        <MFXButton text="📁 Upload Image"
                                   onAction="#handleImageUpload"
                                   style="-fx-background-color: #8b5cf6;
                                  -fx-text-fill: white;
                                  -fx-background-radius: 8;
                                  -fx-padding: 10 20;
                                  -fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-cursor: hand;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
                    </VBox>

                    <!-- Error Message -->
                    <Label fx:id="formErrorMessageLabel"
                           textFill="#ef4444"
                           wrapText="true"
                           GridPane.rowIndex="6"
                           GridPane.columnSpan="2"
                           alignment="CENTER"
                           style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 0 0 0;"/>
                </GridPane>

                <!-- Action Buttons Section -->
                <HBox spacing="15" alignment="CENTER"
                      style="-fx-background-color: #f8fafc;
                     -fx-background-radius: 12;
                     -fx-padding: 20;">
                    <MFXButton text="💾 Save Food Item"
                               onAction="#handleSaveFoodItem"
                               style="-fx-background-color: #10b981;
                              -fx-text-fill: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 24;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-cursor: hand;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>

                    <MFXButton text="❌ Cancel"
                               onAction="#handleCancel"
                               style="-fx-background-color: #6b7280;
                              -fx-text-fill: white;
                              -fx-background-radius: 8;
                              -fx-padding: 12 24;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-cursor: hand;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>