<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodi.appFrontend.tabs.login.Login">

   <stylesheets>
      <URL value="@../css/application.css" />
   </stylesheets>

   <center>
      <!-- Main Login Container -->
      <VBox alignment="CENTER"
            spacing="0"
            style="-fx-background-color: white;
                   -fx-background-radius: 20;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 10);
                   -fx-max-width: 420;
                   -fx-max-height: 580;">

         <!-- Header Section -->
         <VBox alignment="CENTER"
               spacing="15"
               style="-fx-padding: 50 40 30 40; -fx-background-color: transparent;">

            <!-- App Icon/Logo Area -->
            <HBox alignment="CENTER"
                  style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);
                         -fx-background-radius: 50;
                         -fx-pref-width: 100;
                         -fx-pref-height: 100;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
               <Label text="🍔"
                      style="-fx-font-size: 40px;"/>
            </HBox>

            <!-- Welcome Text -->
            <VBox alignment="CENTER" spacing="8">
               <Label text="Welcome Back!"
                      style="-fx-font-size: 28px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #1f2937;"/>
               <Label text="Sign in to Fooody Admin Dashboard"
                      style="-fx-font-size: 14px;
                             -fx-text-fill: #6b7280;
                             -fx-font-weight: 500;"/>
            </VBox>
         </VBox>

         <!-- Form Section -->
         <VBox alignment="CENTER"
               spacing="25"
               style="-fx-padding: 0 40 40 40;">

            <!-- Phone Number Field -->
            <VBox spacing="8" style="-fx-max-width: 340;">
               <Label text="Phone Number"
                      style="-fx-font-size: 14px;
                             -fx-font-weight: 600;
                             -fx-text-fill: #374151;"/>
               <MFXTextField fx:id="phoneField"
                             floatingText="Enter your phone number"
                             prefHeight="50.0"
                             prefWidth="340.0"
                             promptText="Phone Number"
                             style="-fx-background-color: #f8fafc;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #e2e8f0;
                                   -fx-border-width: 1;
                                   -fx-border-radius: 12;
                                   -fx-padding: 0 16;
                                   -fx-font-size: 14px;
                                   -fx-text-fill: #1f2937;" />
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8" style="-fx-max-width: 340;">
               <Label text="Password"
                      style="-fx-font-size: 14px;
                             -fx-font-weight: 600;
                             -fx-text-fill: #374151;"/>
               <MFXPasswordField fx:id="passwordField"
                                 floatingText="Enter your password"
                                 prefHeight="50.0"
                                 prefWidth="340.0"
                                 promptText="Password"
                                 style="-fx-background-color: #f8fafc;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #e2e8f0;
                                       -fx-border-width: 1;
                                       -fx-border-radius: 12;
                                       -fx-padding: 0 16;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #1f2937;" />
            </VBox>

            <!-- Error Message -->
            <Label fx:id="errorMessageLabel"
                   textFill="#ef4444"
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-font-weight: 500;
                          -fx-max-width: 340;
                          -fx-text-alignment: center;"/>

            <!-- Login Button -->
            <MFXButton fx:id="loginButton"
                       onAction="#handleLogin"
                       text="Sign In"
                       prefWidth="340.0"
                       prefHeight="50.0"
                       style="-fx-background-color: #3b82f6;
                             -fx-text-fill: white;
                             -fx-background-radius: 12;
                             -fx-font-size: 16px;
                             -fx-font-weight: bold;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 8, 0, 0, 4);" />

            <!-- Sign Up Link -->
            <HBox alignment="CENTER" spacing="8">
               <Label text="Don't have an account?"
                      style="-fx-font-size: 14px;
                             -fx-text-fill: #6b7280;
                             -fx-font-weight: 500;"/>
               <Hyperlink onAction="#signup"
                          text="Sign Up"
                          style="-fx-font-size: 14px;
                                -fx-text-fill: #3b82f6;
                                -fx-font-weight: 600;
                                -fx-underline: false;"/>
            </HBox>
         </VBox>
      </VBox>
   </center>

   <!-- Footer -->
   <bottom>
      <VBox alignment="CENTER" style="-fx-padding: 20;">
         <Label text="© 2025 Fooody. All rights reserved."
                style="-fx-font-size: 12px;
                       -fx-text-fill: rgba(255,255,255,0.8);
                       -fx-font-weight: 500;"/>
      </VBox>
   </bottom>
</BorderPane>